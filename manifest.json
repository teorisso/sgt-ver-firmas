{
  "manifest_version": 3,
  "name": "SGT · Ver firmas",
  "version": "0.2.2",
  "description": "Verifica firmas digitales de PDFs y descarga las e-Partes con sus títulos en el SGT de Chaco.",
  "action": { "default_title": "SGT · Ver firmas del PDF abierto" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://app.chaco.gob.ar/*"],
  "web_accessible_resources": [
    {
      "resources": ["crl/*.crl.gz"],
      "matches": ["https://app.chaco.gob.ar/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://app.chaco.gob.ar/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.chaco.gob.ar/tramites/servlet/com.ecom.bajar10partes*"],
      "js": ["part-zip-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
